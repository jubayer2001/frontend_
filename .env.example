# Copy this file to .env.local and adjust. Every VITE_* value is shipped to the browser:
# never put a secret here (no passwords, no keys).

# Data source: "demo" (made-up data kept in the browser, no backend needed)
# or "api" (the real backend; it must be running, see README.md).
VITE_CAREWELL_DATA_MODE=demo

# Base URL of the backend API. Keep the relative path: in development Vite forwards /api to the backend
# (VITE_DEV_PROXY_TARGET), and in production Vercel forwards it (vercel.json), so the login cookie stays on one address.
VITE_API_BASE_URL=/api/v1

# Where `npm run dev` forwards requests that start with /api (your running backend).
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Send the login cookie with API requests (required for sign-in in "api" mode).
VITE_API_SEND_CREDENTIALS=true

# The unlisted administrator sign-in address (path only). It is not linked anywhere on the website.
# Choose something hard to guess, for example /staff-7f3k9q, then open  <website>/#/staff-7f3k9q
# Empty = the administrator sign-in page does not exist.
VITE_ADMIN_LOGIN_PATH=

# Only when the site is served from a sub-folder (for example GitHub Pages at /my-repo/). Default is /
# VITE_BASE_PATH=/
